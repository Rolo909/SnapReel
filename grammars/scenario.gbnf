root ::= "{" ws "\"title\"" ws ":" ws string "," ws "\"scenes\"" ws ":" ws "[" ws scene_list "]" ws "}"
scene_list ::= scene (ws "," ws scene)*
scene ::= "{" ws "\"scene_id\"" ws ":" ws integer "," ws "\"narration\"" ws ":" ws string "," ws "\"visual_prompt\"" ws ":" ws string "," ws "\"duration_hint\"" ws ":" ws number "," ws "\"sfx\"" ws ":" ws string ws "}"
integer ::= [0-9]+
number ::= [0-9]+ ("." [0-9]+)?
string ::= "\"" ([^"\\] | "\\" (["\\/bfnrt] | "u" [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F] [0-9a-fA-F]))* "\""
ws ::= [ \t\n]*
